# JOFP 1.0 — JSL Omega Field Protocol
# Block Space Network Connection Protocol

PROTOCOL JOFP/1.0
OMEGA Ω0 = (0,0,0)
FIELD ΩField

IDENTITY {
  node_id
  omega_id
  sign_public_key
  ecdh_public_key
  coordinate(x,y,z)
}

SECURE_ENVELOPE {
  version
  message_id
  from_node
  to_node
  timestamp
  expires_at
  nonce
  iv
  ciphertext
  signature
}

COMMAND REGISTER
COMMAND DISCOVER
COMMAND RESOLVE
COMMAND PAIR
COMMAND SEND
COMMAND RECEIVE
COMMAND DELIVERED
COMMAND FIELD
COMMAND COIN_INIT
COMMAND COIN_TRANSFER
COMMAND COIN_BALANCE
COMMAND COIN_HISTORY

FLOW Device -> REGISTER -> IDENTITY -> NORMALIZE -> J(x,y,z) -> ΩField
FLOW Node_A -> RESOLVE(Node_B) -> ECDH -> AES-GCM -> SIGN -> SEND
FLOW Node_B -> RECEIVE -> VERIFY -> ECDH -> DECRYPT -> DELIVERED
FLOW Node_A -> COIN_TRANSFER -> VERIFY -> ΩLedger -> Node_B

RULE PRIVATE_KEYS_DEVICE_LOCAL
RULE SIGNATURE_REQUIRED
RULE ENCRYPTED_PAYLOAD_ONLY
RULE REPLAY_NONCE_UNIQUE
RULE MESSAGE_EXPIRY_REQUIRED
RULE NO_PREVIOUS_HASH
RULE NO_LINEAR_CHAIN
RULE FIELD_ROUTING
