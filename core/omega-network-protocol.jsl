# JSL Omega Network Protocol Alpha 1.0 — Pure JSL Core

PROTOCOL JOFP/1.0
OMEGA Ω0 = (0,0,0)
FIELD ΩField

COMMAND REGISTER
COMMAND HEARTBEAT
COMMAND DISCOVER
COMMAND PAIR
COMMAND SEND
COMMAND RECEIVE
COMMAND RESOLVE
COMMAND FIELD

FLOW Device -> REGISTER -> NORMALIZE -> J(x,y,z) -> ΩField
FLOW Node_A -> PAIR -> ΩField -> Node_B
FLOW Node_A -> SEND -> ΩField -> RECEIVE -> Node_B

RULE NO_PREVIOUS_HASH
RULE NO_LINEAR_CHAIN
RULE NODE_EQUALITY
RULE FIELD_ROUTING
